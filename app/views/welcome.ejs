<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Slink | Welcome</title>
    <link rel="icon" href="/images/slink-logo.png" type="image/x-icon">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        .welcome-card {
            backdrop-filter: blur(10px);
            background: rgba(255, 255, 255, 0.9);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            width: min(94vw, 78rem);
            height: auto;
            border-radius: 1rem;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 3.5rem 4rem;
        }
        .nav-button {
            transition: background-color 0.2s ease, opacity 0.2s ease;
            padding: 1.75rem 1.5rem;
            border-radius: 0.75rem;
        }
        .nav-button:hover {
            opacity: 0.9;
        }
        @media (max-width: 767px) {
            body {
                padding: 0 !important;
                align-items: stretch !important;
            }
            .welcome-card {
                width: 100%;
                min-height: 100vh;
                border-radius: 0;
                padding: 3.25rem 1.25rem 2.25rem;
                box-shadow: none;
            }
            .welcome-title-wrap {
                margin-top: 1.5rem;
                margin-bottom: 2.75rem;
            }
            .welcome-buttons {
                gap: 1rem;
                width: 100%;
            }
            .nav-button {
                width: 100%;
                padding: 1.35rem 1.15rem;
            }
        }
        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }
        .typing-cursor::after {
            content: '|';
            color: #000;
            animation: blink 0.8s step-end infinite;
            margin-left: 2px;
        }
        body {
            overflow: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        ::-webkit-scrollbar {
            display: none;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-gray-100 to-gray-200 min-h-screen flex items-center justify-center p-4">
    <div class="welcome-card relative z-10">
        <div class="welcome-title-wrap flex items-center justify-center mb-10">
            <h1 id="welcomeTitle" class="text-5xl md:text-6xl lg:text-7xl font-bold text-black typing-cursor">Welcome to Slink!</h1>
        </div>

        <div class="hidden md:block text-center mb-12">
            <p class="text-xl md:text-2xl text-gray-600">To get started, you can either explore the alumni directory or complete your profile <i class="fas fa-sparkles text-[#602234]"></i></p>
        </div>

        <div class="welcome-buttons grid md:grid-cols-2 gap-8 w-full">
            <a href="/directory" class="nav-button bg-[#602234] text-white text-center hover:bg-[#531e2e] group">
                <i class="fas fa-users text-3xl md:text-4xl mb-3"></i>
                <h3 class="text-xl md:text-2xl font-bold mb-2">Explore Directory</h3>
                <p class="text-gray-200">Browse through SEM alumni and connect with them</p>
            </a>

            <a href="/profile" class="nav-button bg-black text-white text-center hover:bg-gray-900 group">
                <i class="fas fa-user-edit text-3xl md:text-4xl mb-3"></i>
                <h3 class="text-xl md:text-2xl font-bold mb-2">Complete Profile</h3>
                <p class="text-gray-200">Add more details to your profile to help others find you</p>
            </a>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            const text = 'Welcome to Slink!';
            const title = $('#welcomeTitle');
            let i = 0;
            title.text('');

            function typeNext() {
                if (i < text.length) {
                    title.text(text.slice(0, ++i));
                    setTimeout(typeNext, 70);
                } else {
                    title.removeClass('typing-cursor');
                }
            }

            typeNext();

            function shootConfetti() {
                const colors = ['#602234', '#000000', '#ffffff'];
                
                const duration = 3 * 1000;
                const animationEnd = Date.now() + duration;
                const defaults = { startVelocity: 40, spread: 360, ticks: 100, zIndex: 0 };

                function randomInRange(min, max) {
                    return Math.random() * (max - min) + min;
                }

                const interval = setInterval(function() {
                    const timeLeft = animationEnd - Date.now();

                    if (timeLeft <= 0) {
                        return clearInterval(interval);
                    }

                    const particleCount = 50 * (timeLeft / duration);
                    
                    for (let i = 0; i < 3; i++) {
                        confetti({
                            ...defaults,
                            particleCount,
                            origin: { x: randomInRange(0.1, 0.9), y: Math.random() - 0.2 },
                            colors: colors
                        });
                    }
                }, 100);
            }

            shootConfetti();
        });
    </script>
</body>
</html>
