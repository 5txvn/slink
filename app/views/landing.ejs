<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Slink | Landing</title>
    <link rel="icon" href="/images/slink-logo.png" type="image/x-icon">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html, body {
            overflow: scroll;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        html::-webkit-scrollbar,
        body::-webkit-scrollbar {
            display: none;
        }
        @keyframes gradient-flow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .gradient-text {
            background: linear-gradient(45deg, #602234, #602234);
            background-size: 200% 200%;
            animation: gradient-flow 3s ease-in-out infinite;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .dot-pattern {
            background-color: #f0ece2;
        }
        .nav-link {
            position: relative;
            transition: all 0.3s ease;
        }
        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: -2px;
            left: 0;
            background-color: #602234;
            transition: width 0.3s ease;
        }
        .nav-link:hover::after {
            width: 100%;
        }
        .card-hover {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }
        .button-shadow {
            box-shadow: inset -2px -2px 4px rgba(0,0,0,0.1);
        }
        .button-shadow:hover {
            box-shadow: inset -4px -4px 8px rgba(0,0,0,0.15); 
        }
        @keyframes spin-slow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-spin-slow {
            animation: spin-slow 8s linear infinite;
        }
        .message-bubble {
            position: relative;
            opacity: 0;
            transform: translateY(20px);
            animation: messageAppear 0.5s forwards;
        }
        .message-bubble::before {
            content: '';
            position: absolute;
            bottom: -10px;
            width: 0;
            height: 0;
            border-style: solid;
        }
        .message-bubble.left::before {
            left: 0;
            bottom: -10px;
            border-width: 24px 24px 0 0;
            border-color: #000 transparent transparent transparent;
        }
        .message-bubble.right::before {
            right: 0;
            bottom: -10px;
            border-width: 24px 0 0 24px;
            border-color: #000 transparent transparent transparent;
        }
        @keyframes messageAppear {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .typing-indicator {
            display: flex;
            gap: 6px;
            padding: 12px 16px;
            background: #f0f0f0;
            border-radius: 16px;
            width: fit-content;
            opacity: 0;
            transform: translateY(20px);
            animation: typingAppear 0.5s forwards;
        }
        .typing-dot {
            width: 10px;
            height: 10px;
            background: #666;
            border-radius: 50%;
            animation: typingAnimation 1.4s infinite;
        }
        .typing-dot:nth-child(2) { animation-delay: 0.2s; }
        .typing-dot:nth-child(3) { animation-delay: 0.4s; }
        @keyframes typingAnimation {
            0%, 60%, 100% { transform: translateY(0); }
            30% { transform: translateY(-4px); }
        }
        @keyframes typingAppear {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .stats-card {
            transition: all 0.3s ease;
        }
        .stats-card:hover {
            transform: scale(1.05);
            box-shadow: 0 15px 30px rgba(0,0,0,0.1);
        }
        .checkmark {
            opacity: 0;
            transform: scale(0);
            transition: all 0.3s ease;
        }
        .checkmark.visible {
            opacity: 1;
            transform: scale(1);
        }
        .input-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: black;
        }
        .input-with-icon {
            padding-left: 40px;
        }
        .char-counter {
            font-size: 0.875rem;
            font-weight: bold;
            color: #602234;
            text-align: right;
            margin-top: 0.25rem;
        }
        .float-bubbles {
            display: none;
        }
        @media (max-width: 767px) {
            .float-bubbles {
                display: block;
                position: fixed;
                inset: 0;
                overflow: hidden;
                pointer-events: none;
                z-index: 0;
            }
            .float-bubble {
                position: absolute;
                left: var(--x);
                bottom: -20%;
                background: rgba(255, 255, 255, 0.88);
                border: 1.5px solid #602234;
                color: #602234;
                border-radius: 1.15rem 1.15rem 1.15rem 0.3rem;
                padding: 0.7rem 0.95rem;
                font-size: 0.92rem;
                font-weight: 600;
                max-width: 70vw;
                box-shadow: 0 8px 18px rgba(96, 34, 52, 0.08);
                animation: floatUp var(--dur) linear infinite;
                animation-delay: var(--delay);
                white-space: nowrap;
            }
            .float-bubble.alt {
                border-radius: 1.15rem 1.15rem 0.3rem 1.15rem;
                background: #602234;
                color: #fff;
            }
            @keyframes floatUp {
                0% { transform: translateY(0); opacity: 0; }
                8% { opacity: 0.9; }
                85% { opacity: 0.9; }
                100% { transform: translateY(-120vh); opacity: 0; }
            }
        }
    </style>
</head>
