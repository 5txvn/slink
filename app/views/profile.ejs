<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Slink | Profile</title>
    <link rel="icon" href="/images/slink-logo.png" type="image/x-icon">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html, body {
            overflow: scroll;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        html::-webkit-scrollbar,
        body::-webkit-scrollbar {
            display: none;
        }
        .dot-pattern {
            background-attachment: fixed;
            background-image: radial-gradient(rgba(96, 34, 52, 0.5) 1px, transparent 1px);
            background-size: 20px 20px;
            background-color: #ffffff;
        }
        .gradient-text {
            background: linear-gradient(45deg, #602234, #602234);
            background-size: 200% 200%;
            animation: gradient-flow 3s ease-in-out infinite;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            line-height: 1.2;
        }
        @keyframes gradient-flow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .modern-card {
            background: #fff;
            border-radius: 1.25rem;
            box-shadow: 0 4px 24px 0 rgba(60,0,0,0.08), 0 1.5px 8px #e0e0e0;
            transition: box-shadow 0.2s;
        }
        .modern-card:hover {
            box-shadow: 0 8px 32px 0 rgba(60,0,0,0.13), 0 2.5px 12px #e0e0e0;
        }
        .modern-input {
            background: #f7f7fa;
            border-radius: 0.75rem;
            border: 2px solid #e5e7eb;
            box-shadow: 0 1.5px 6px #ececec;
            transition: border 0.2s, box-shadow 0.2s;
        }
        .modern-input:focus {
            border: 2px solid #602234;
            box-shadow: 0 2px 12px #e0e0e0;
        }
        .input-icon {
            top: 50% !important;
            transform: translateY(-50%) !important;
        }
        .neumorphic-btn {
            background: #f7f7f7;
            border-radius: 1rem;
            box-shadow: 4px 4px 12px #d1d1d1, -4px -4px 12px #ffffff, inset 0 6px 16px #e0e0e0, inset 6px 0 16px #f7f7f7;
            border: none;
            transition: transform 0.4s cubic-bezier(.4,0,.2,1), box-shadow 0.2s;
            width: 100%;
            margin-left: 2.5vw;
            margin-right: 2.5vw;
            padding-top: 1.2rem;
            padding-bottom: 1.2rem;
        }
        .neumorphic-btn:hover {
            transform: translateY(-10px) scale(1.03);
            box-shadow: 8px 8px 24px #d1d1d1, -8px -8px 24px #ffffff, inset 0 8px 24px #e0e0e0, inset 8px 0 24px #f7f7f7;
        }
        .pulse-text {
            animation: pulse 1.8s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }
        .error-toast {
            position: fixed;
            top: 1rem;
            left: 50%;
            transform: translateX(-50%);
            padding: 1rem;
            border-radius: 0.5rem;
            background: #602234;
            color: white;
            display: none;
            z-index: 50;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            transition: all 0.3s ease;
            animation: slideDown 0.3s ease-out;
        }
        @keyframes slideDown {
            from { transform: translate(-50%, -100%); }
            to { transform: translate(-50%, 0); }
        }
        .error-toast:hover {
            transform: translateX(-50%) scale(1.02);
            background: #4a1a28;
        }
        .autocomplete-dropdown {
            display: none;
            position: absolute;
            left: 0;
            right: 0;
            top: 100%;
            z-index: 30;
            background: white;
            border: 1px solid #000;
            margin-top: 0.25rem;
            max-height: 220px;
            overflow-y: auto;
        }
        .autocomplete-option {
            padding: 0.75rem 1rem;
            cursor: pointer;
            color: #374151;
        }
        .autocomplete-option:hover,
        .autocomplete-option.active {
            background: #602234;
            color: white;
        }
        .value-chip {
            background: #602234;
            color: white;
            padding: 0.35rem 0.75rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.9rem;
            border-radius: 0.5rem;
        }
        .chips {
            min-height: 0;
        }
        .empty-chips {
            color: #9ca3af;
            font-style: italic;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
        }
        @media (max-width: 767px) {
            .empty-chips {
                display: none !important;
            }
            .chips {
                min-height: 0;
            }
            .chips:not(:has(.value-chip)) {
                display: none;
            }
        }
        .custom-select-options {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: white;
            border: 1px solid #000;
            border-radius: 0.5rem;
            margin-top: 0.5rem;
            z-index: 40;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .custom-select-option {
            padding: 0.75rem 1rem;
            cursor: pointer;
            color: #718096;
        }
        .custom-select-option:hover {
            background: #602234;
            color: white;
        }
        .value-chip button {
            background: none;
            border: none;
            color: white;
            cursor: pointer;
            font-size: 1rem;
            line-height: 1;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col dot-pattern">
    <div id="navbar-container"></div>
    <div id="notification" class="notification"></div>

    <main class="container w-[90vw] mx-auto py-4 md:py-8 mt-20">
        <div class="w-full">
            <form id="profile-form" action="/profile" method="POST" class="bg-white rounded-xl p-4 md:p-8 shadow-lg border-2 border-[#602234]">
                <div class="flex justify-between items-center mb-6 md:mb-8">
                    <h1 class="text-4xl md:text-5xl font-extrabold gradient-text">Edit Profile</h1>
                    <a href="/user/<%= JSON.parse(user).username %>" class="bg-[#602234] hover:bg-[#4a1a28] text-white font-semibold w-10 h-10 md:w-auto md:h-auto rounded-full md:rounded-lg transition-colors flex items-center justify-center md:py-2 md:px-4">
                        <i class="fas fa-eye md:mr-2"></i>
                        <span class="hidden md:inline">View Your Profile</span>
                    </a>
                </div>
                <div class="flex flex-col gap-6">
                    <div class="flex flex-col gap-1">
                        <label class="block text-xl font-medium text-black">Full Name</label>
                        <div class="flex flex-row relative">
                            <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                <i class="fas fa-user"></i>
                            </div>
                            <input type="text" name="name" maxlength="50" class="w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300" placeholder="Enter your full name" required>
                        </div>
                        <div class="hidden md:block text-sm text-gray-500 text-right"><span id="name-count">0</span>/50</div>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label class="block text-xl font-medium text-black">Bio</label>
                        <textarea name="bio" maxlength="1000" class="w-full px-4 py-3 rounded-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300 h-32" placeholder="Tell us about yourself..."></textarea>
                        <div class="hidden md:block text-sm text-gray-500 text-right"><span id="bio-count">0</span>/1000</div>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label class="block text-xl font-medium text-black">Role</label>
                        <div class="relative custom-select">
                            <div class="flex flex-row cursor-pointer" id="roleSelect">
                                <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                    <i class="fas fa-user-tag"></i>
                                </div>
                                <div class="w-full px-4 py-3 border-y border-black text-gray-500 bg-white" id="roleSelectText">
                                    Select your role
                                </div>
                                <div class="rounded-r-lg bg-white flex items-center justify-center px-4 border border-l-0 border-black">
                                    <i class="fas fa-chevron-down text-gray-600"></i>
                                </div>
                            </div>
                            <div class="custom-select-options">
                                <div class="custom-select-option" data-value="alumni">Alumni</div>
                                <div class="custom-select-option" data-value="student">Student</div>
                                <div class="custom-select-option" data-value="staff">Staff</div>
                                <div class="custom-select-option" data-value="parent">Parent</div>
                            </div>
                            <input type="hidden" name="position">
                        </div>
                    </div>

                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-10 gap-y-6 mt-2 items-stretch">
                            <div class="multi-field flex flex-col h-full" data-field="school" data-suggest="schools" data-empty="No colleges added yet...">
                                <label class="block text-xl font-medium text-black mb-2">College(s)</label>
                                <div class="chips flex flex-wrap gap-2 mb-2 content-start"></div>
                                <div class="relative">
                                    <div class="flex flex-row">
                                        <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                            <i class="fas fa-graduation-cap"></i>
                                        </div>
                                        <input type="text" maxlength="100" autocomplete="off" class="multi-input w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300" placeholder="Type a school and press Enter">
                                    </div>
                                    <div class="autocomplete-dropdown"></div>
                                </div>
                            </div>

                            <div class="multi-field flex flex-col h-full" data-field="currentPosition" data-suggest="positions" data-empty="No positions added yet...">
                                <label class="block text-xl font-medium text-black mb-2">Position(s)</label>
                                <div class="chips flex flex-wrap gap-2 mb-2 content-start"></div>
                                <div class="relative">
                                    <div class="flex flex-row">
                                        <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                            <i class="fas fa-briefcase"></i>
                                        </div>
                                        <input type="text" maxlength="100" autocomplete="off" class="multi-input w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300" placeholder="Type a position and press Enter">
                                    </div>
                                    <div class="autocomplete-dropdown"></div>
                                </div>
                            </div>

                            <div class="multi-field flex flex-col h-full" data-field="major" data-suggest="majors" data-empty="No majors added yet...">
                                <label class="block text-xl font-medium text-black mb-2">Major(s)</label>
                                <div class="chips flex flex-wrap gap-2 mb-2 content-start"></div>
                                <div class="relative">
                                    <div class="flex flex-row">
                                        <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                            <i class="fas fa-book"></i>
                                        </div>
                                        <input type="text" maxlength="100" autocomplete="off" class="multi-input w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300" placeholder="Type a major and press Enter">
                                    </div>
                                    <div class="autocomplete-dropdown"></div>
                                </div>
                            </div>

                            <div class="multi-field flex flex-col h-full" data-field="company" data-empty="No companies added yet...">
                                <label class="block text-xl font-medium text-black mb-2">Company(s)</label>
                                <div class="chips flex flex-wrap gap-2 mb-2 content-start"></div>
                                <div class="flex flex-row">
                                    <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                        <i class="fas fa-building"></i>
                                    </div>
                                    <input type="text" maxlength="100" autocomplete="off" class="multi-input w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300" placeholder="Type a company and press Enter">
                                </div>
                            </div>

                            <div class="flex flex-col h-full">
                                <label class="block text-xl font-medium text-black mb-2">High School Graduation Year</label>
                                <div class="chips flex flex-wrap gap-2 mb-2 content-start">
                                    <span class="empty-chips">Enter high school graduation year below...</span>
                                </div>
                                <div class="flex flex-row relative">
                                    <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                        <i class="fas fa-calendar"></i>
                                    </div>
                                    <input type="number" name="graduationYear" min="1900" max="2100" step="1" inputmode="numeric" class="w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300" placeholder="Enter your graduation year">
                                </div>
                            </div>

                            <div class="multi-field flex flex-col h-full" data-field="location" data-suggest="cities" data-empty="No locations added yet...">
                                <label class="block text-xl font-medium text-black mb-2">Location(s)</label>
                                <div class="chips flex flex-wrap gap-2 mb-2 content-start"></div>
                                <div class="relative">
                                    <div class="flex flex-row">
                                        <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                            <i class="fas fa-map-marker-alt"></i>
                                        </div>
                                        <input type="text" maxlength="100" autocomplete="off" class="multi-input w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300" placeholder="Type a city and press Enter">
                                    </div>
                                    <div class="autocomplete-dropdown"></div>
                                </div>
                            </div>

                            <div class="multi-field flex flex-col h-full" data-field="interests" data-suggest="interests" data-empty="No interests added yet...">
                                <label class="block text-xl font-medium text-black mb-2">Interest(s)</label>
                                <div class="chips flex flex-wrap gap-2 mb-2 content-start"></div>
                                <div class="relative">
                                    <div class="flex flex-row">
                                        <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                            <i class="fas fa-heart"></i>
                                        </div>
                                        <input type="text" maxlength="100" autocomplete="off" class="multi-input w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300" placeholder="Type an interest and press Enter">
                                    </div>
                                    <div class="autocomplete-dropdown"></div>
                                </div>
                            </div>

                            <div class="multi-field flex flex-col h-full" data-field="extracurriculars" data-suggest="extracurriculars" data-empty="No extracurriculars added yet...">
                                <label class="block text-xl font-medium text-black mb-2">Extracurricular(s)</label>
                                <div class="chips flex flex-wrap gap-2 mb-2 content-start"></div>
                                <div class="relative">
                                    <div class="flex flex-row">
                                        <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                            <i class="fas fa-trophy"></i>
                                        </div>
                                        <input type="text" maxlength="120" autocomplete="off" class="multi-input w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300" placeholder="Type an extracurricular and press Enter">
                                    </div>
                                    <div class="autocomplete-dropdown"></div>
                                </div>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-6 mt-6 md:mt-8">

                            <div class="space-y-4">
                                <label class="block text-xl font-medium text-black mb-2">LinkedIn</label>
                                <div class="flex flex-row relative">
                                    <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                        <i class="fab fa-linkedin"></i>
                                    </div>
                                    <input type="text" name="linkedin" class="w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300" placeholder="https://linkedin.com/in/...">
                                </div>

                                <label class="block text-xl font-medium text-black mb-2">Instagram</label>
                                <div class="flex flex-row relative">
                                    <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                        <i class="fab fa-instagram"></i>
                                    </div>
                                    <input type="text" name="instagram" class="w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300" placeholder="https://instagram.com/...">
                                </div>
                            </div>
                            <div class="space-y-4">
                                <label class="block text-xl font-medium text-black mb-2">Discord</label>
                                <div class="flex flex-row relative">
                                    <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                        <i class="fab fa-discord"></i>
                                    </div>
                                    <input type="text" name="discord" class="w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300" placeholder="Enter your Discord username">
                                </div>

                                <label class="block text-xl font-medium text-black mb-2">Personal Website</label>
                                <div class="flex flex-row relative">
                                    <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                        <i class="fas fa-globe"></i>
                                    </div>
                                    <input type="text" name="website" class="w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300" placeholder="https://...">
                                </div>
                            </div>
                        </div>
                    </div>
                <div class="flex justify-center mt-10 md:mt-8">
                    <button type="submit" class="w-full bg-[#602234] hover:bg-[#4a1a28] text-white text-lg md:text-xl font-bold rounded-lg px-8 py-4 transition-transform duration-200">
                        <i class="fas fa-save mr-2"></i>
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </main>

    <!-- Error Toast -->
    <div id="errorToast" class="error-toast w-11/12 sm:w-3/4 md:w-2/3 lg:w-1/2">
        <div class="flex items-center justify-center">
            <i class="fas fa-exclamation-circle mr-2 text-xl"></i>
            <span id="errorMessage" class="text-lg font-semibold"></span>
        </div>
    </div>

    <script type="application/json" id="user-json"><%- user %></script>
    <script>
        window.userData = JSON.parse(document.getElementById('user-json').textContent);
    </script>
    <script type="module">
        import Navbar from '../../components/navbar.js';
        
        const navbar = new Navbar();
        document.getElementById('navbar-container').innerHTML = navbar.render();
        navbar.init();
    </script>
    <script>
        const multiFields = ['school', 'major', 'currentPosition', 'company', 'location', 'interests', 'extracurriculars'];
        const suggestionCache = {};

        function toList(value) {
            if (Array.isArray(value)) {
                const filtered = value.filter(v => v && String(v).trim() && String(v).toLowerCase() !== 'n/a');
                if (filtered.length > 1 && filtered.every(v => String(v).length === 1)) {
                    return [filtered.join('')];
                }
                return filtered;
            }
            if (!value || String(value).toLowerCase() === 'n/a') return [];
            return [String(value)];
        }

        function renderChips($field) {
            const values = $field.data('values') || [];
            const $chips = $field.find('.chips');
            const emptyText = $field.data('empty') || 'No items added yet...';
            $chips.empty();
            if (!values.length) {
                $chips.append(`<span class="empty-chips"></span>`);
                $chips.find('.empty-chips').text(emptyText);
                return;
            }
            values.forEach((value, index) => {
                const $chip = $(`
                    <span class="value-chip">
                        <span></span>
                        <button type="button" aria-label="Remove">&times;</button>
                    </span>
                `);
                $chip.find('span').first().text(value);
                $chip.find('button').on('click', function() {
                    const next = ($field.data('values') || []).filter((_, i) => i !== index);
                    $field.data('values', next);
                    renderChips($field);
                });
                $chips.append($chip);
            });
        }

        function addValue($field, rawValue) {
            const value = (rawValue || '').trim();
            if (!value) return;
            const values = $field.data('values') || [];
            if (values.some(v => v.toLowerCase() === value.toLowerCase())) return;
            values.push(value);
            $field.data('values', values);
            renderChips($field);
            $field.find('.multi-input').val('');
            $field.find('.autocomplete-dropdown').hide().empty();
        }

        async function loadSuggestions(name) {
            if (!name) return [];
            if (suggestionCache[name]) return suggestionCache[name];
            const response = await fetch(`/data/${name}.txt`);
            const text = await response.text();
            suggestionCache[name] = text.split(/\r?\n/).map(line => line.trim()).filter(Boolean);
            return suggestionCache[name];
        }

        function showSuggestions($field, matches) {
            const $dropdown = $field.find('.autocomplete-dropdown');
            if (!matches.length) {
                $dropdown.hide().empty();
                return;
            }
            $dropdown.empty();
            matches.slice(0, 8).forEach((match, index) => {
                const $option = $('<div class="autocomplete-option"></div>').text(match);
                if (index === 0) $option.addClass('active');
                $option.on('mousedown', function(e) {
                    e.preventDefault();
                    addValue($field, match);
                });
                $dropdown.append($option);
            });
            $dropdown.show();
        }

        function populateForm() {
            const form = $('#profile-form');
            const userData = window.userData || {};
            for (const [key, value] of Object.entries(userData)) {
                if (key === 'socialLinks') {
                    for (const [socialKey, socialValue] of Object.entries(value || {})) {
                        const input = form.find(`[name="${socialKey}"]`);
                        if (input.length) {
                            let next = socialValue === 'n/a' ? '' : socialValue;
                            if (socialKey === 'discord') next = String(next || '').replace(/^https?:\/\//i, '').replace(/^www\./i, '');
                            input.val(next);
                        }
                    }
                } else if (key === 'position' && value) {
                    const label = value.charAt(0).toUpperCase() + value.slice(1);
                    $('#roleSelectText').text(label).removeClass('text-gray-500').addClass('text-black');
                    $('input[name="position"]').val(value);
                    $(`.custom-select-option[data-value="${value}"]`).addClass('selected');
                } else if (multiFields.includes(key)) {
                    const $field = form.find(`.multi-field[data-field="${key}"]`);
                    $field.data('values', toList(value));
                    renderChips($field);
                } else {
                    const input = form.find(`[name="${key}"]`);
                    if (input.length) {
                        const next = (!value || ['n/a', 'no bio yet...'].includes(String(value).toLowerCase())) ? '' : (value || '');
                        input.val(next);
                    }
                }
            }
        }

        function updateCharCount(inputId, maxLength) {
            const input = $(`[name="${inputId}"]`);
            const counter = $(`#${inputId}-count`);
            input.on('input', function() {
                const length = $(this).val().length;
                counter.text(length);
                counter.toggleClass('text-red-500', length > maxLength * 0.9);
            });
            counter.text(input.val().length);
        }

        $(document).ready(function() {
            populateForm();
            updateCharCount('name', 50);
            updateCharCount('bio', 1000);

            $('input[name="graduationYear"]').on('input', function() {
                this.value = this.value.replace(/\D/g, '').slice(0, 4);
            });

            $('#roleSelect').on('click', function() {
                $('.custom-select-options').slideToggle();
            });
            $('.custom-select-option').on('click', function(e) {
                e.stopPropagation();
                const value = $(this).data('value');
                $('#roleSelectText').text($(this).text()).removeClass('text-gray-500').addClass('text-black');
                $('input[name="position"]').val(value);
                $('.custom-select-options').slideUp();
                $('.custom-select-option').removeClass('selected');
                $(this).addClass('selected');
            });
            $(document).on('click', function(e) {
                if (!$(e.target).closest('.custom-select').length) {
                    $('.custom-select-options').slideUp();
                }
            });

            $('.multi-field').each(function() {
                const $field = $(this);
                if (!$field.data('values')) $field.data('values', []);
                renderChips($field);
                const suggestName = $field.data('suggest');
                if (suggestName) loadSuggestions(suggestName);

                $field.find('.multi-input').on('input', async function() {
                    const query = $(this).val().trim().toLowerCase();
                    if (!suggestName || query.length < 1) {
                        $field.find('.autocomplete-dropdown').hide().empty();
                        return;
                    }
                    const suggestions = await loadSuggestions(suggestName);
                    const matches = suggestions.filter(item => item.toLowerCase().includes(query));
                    showSuggestions($field, matches);
                });

                $field.find('.multi-input').on('keydown', function(e) {
                    const $dropdown = $field.find('.autocomplete-dropdown');
                    const $active = $dropdown.find('.autocomplete-option.active');
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        if ($dropdown.is(':visible') && $active.length) {
                            addValue($field, $active.text());
                        } else {
                            addValue($field, $(this).val());
                        }
                    } else if (e.key === 'ArrowDown' && $dropdown.is(':visible')) {
                        e.preventDefault();
                        const $next = $active.next('.autocomplete-option');
                        if ($next.length) {
                            $active.removeClass('active');
                            $next.addClass('active');
                        }
                    } else if (e.key === 'ArrowUp' && $dropdown.is(':visible')) {
                        e.preventDefault();
                        const $prev = $active.prev('.autocomplete-option');
                        if ($prev.length) {
                            $active.removeClass('active');
                            $prev.addClass('active');
                        }
                    } else if (e.key === 'Escape') {
                        $dropdown.hide();
                    }
                });

                $field.find('.multi-input').on('blur', function() {
                    setTimeout(() => $field.find('.autocomplete-dropdown').hide(), 150);
                });
            });

            $('#profile-form').on('submit', function() {
                $('.multi-field').each(function() {
                    const $field = $(this);
                    addValue($field, $field.find('.multi-input').val());
                    const fieldName = $field.data('field');
                    const values = $field.data('values') || [];
                    $field.find(`input.multi-json[name="${fieldName}"]`).remove();
                    $('<input type="hidden" class="multi-json">')
                        .attr('name', fieldName)
                        .val(JSON.stringify(values))
                        .appendTo($field);
                });
            });
        });
    </script>
</body>
</html> 