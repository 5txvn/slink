<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Slink | Directory</title>
    <link rel="icon" href="/images/slink-logo.png" type="image/x-icon">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body, html, #filterModal, #columnsModal {
            overflow: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        body::-webkit-scrollbar,
        html::-webkit-scrollbar,
        #filterModal::-webkit-scrollbar,
        #columnsModal::-webkit-scrollbar {
            display: none;
        }
        .dot-pattern {
            background-attachment: fixed;
            background-image: radial-gradient(rgba(96, 34, 52, 0.5) 1px, transparent 1px), radial-gradient(rgba(0, 0, 0, 0.5) 1px, transparent 1px);
            background-size: 20px 20px;
            background-color: #ffffff;
        }
        .modern-card {
            background: #fff;
            border-radius: 1.25rem;
            border: 2px solid #e5e7eb;
            box-shadow: none;
            overflow-x: auto;
        }
        .modern-card:hover {
            box-shadow: none;
        }
        .modern-input {
            background: #f7f7fa;
            border-radius: 0.75rem;
            border: 2px solid #e5e7eb;
            box-shadow: none;
            transition: border 0.2s;
        }
        .modern-input:focus {
            border: 2px solid #602234;
            box-shadow: none;
        }
        .input-icon {
            top: 50% !important;
            transform: translateY(-50%) !important;
        }
        .modal {
            max-width: 800px !important;
        }
        /* Neumorphic inner shadow for buttons */
        .neumorphic-btn {
            background: #f7f7f7;
            border: 1.5px solid #222;
            transition: all 0.2s ease;
            box-shadow: none !important;
        }
        .neumorphic-btn:active {
            transform: scale(0.95);
        }
        .neumorphic-btn, .close-button {
            box-shadow: inset 4px 4px 10px #c0bebe, inset 6px 6px 16px #e0e0e0 !important;
        }
        .close-button {
            background: #800000;
            color: #fff;
            border: none;
            border-radius: 0.375rem;
            font-weight: 500;
            transition: all 0.2s ease;
            box-shadow: inset 2px 2px 6px #5a0000, inset 3px 3px 8px #a94442;
        }
        .close-button:hover {
            background: #a94442;
        }
        .modal-content.nice-modal, .modal-content.neumorphic {
            box-shadow: inset 4px 4px 12px #e0e0e0, inset 8px 8px 18px #f7f7f7;
        }
        .directory-title {
            background-size: 200% 200%;
            animation: gradient-flow 3s ease-in-out infinite;
        }
        @keyframes gradient-flow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        /* Table header icon colors */
        .icon-user { color: #602234; }
        .icon-university { color: #6b7280; }
        .icon-graduation { color: #602234; }
        .icon-calendar { color: #6b7280; }
        .icon-briefcase { color: #602234; }
        .icon-building { color: #6b7280; }
        .icon-location { color: #602234; }
        /* Hide up/down arrows in table headers */
        .sort-icon { display: none !important; }
        .neumorphic {
            background: #f0f0f0;
            box-shadow: 4px 4px 10px #d1d1d1,
                       -4px -4px 10px #ffffff;
        }
        .neumorphic-btn {
            background: #f0f0f0;
            box-shadow: 4px 4px 8px #d1d1d1,
                       -4px -4px 8px #ffffff;
            transition: all 0.2s ease;
        }
        .neumorphic-btn:active {
            transform: scale(0.95);
        }
        .maroon-bg {
            background-color: #602234;
        }
        .maroon-text {
            color: #602234;
        }
        .hover-scale {
            transition: transform 0.2s ease;
        }
        .hover-scale:hover {
            transform: scale(1.02);
        }
        .table-header {
            position: sticky;
            top: 0;
            background: #f8f9fa;
            z-index: 10;
        }
        .table-container {
            margin-top: 1rem;
            position: relative;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        table {
            width: 100%;
            table-layout: auto;
        }
        table th, table td {
            overflow-wrap: normal;
            word-break: normal;
            white-space: nowrap;
        }
        @media (min-width: 768px) {
            table {
                min-width: 980px;
            }
            table th, table td {
                min-width: 160px;
                padding-left: 1.25rem;
                padding-right: 1.25rem;
            }
        }
        @media (max-width: 767px) {
            table {
                min-width: 620px;
                font-size: 0.75rem;
            }
            table th, table td {
                min-width: 92px;
                padding: 0.4rem 0.45rem;
            }
            table .name-col {
                min-width: 72px;
                max-width: 84px;
                overflow: hidden;
                text-overflow: ellipsis;
            }
        }
        .table-row:hover {
            background-color: rgba(128, 0, 0, 0.05);
        }
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            z-index: 1000;
        }
        .modal-content {
            position: relative;
            margin: 10% auto;
            padding: 20px;
            width: 80%;
            max-width: 600px;
            border-radius: 8px;
        }
        .sort-icon {
            opacity: 0.3;
        }
        .sort-active {
            opacity: 1;
        }
        .filter-tag {
            background-color: #602234;
            color: white;
            padding: 4px 12px;
            border-radius: 16px;
            font-size: 0.875rem;
            display: inline-flex;
            align-items: center;
            margin: 4px;
        }
        .filter-tag .close {
            margin-left: 8px;
            cursor: pointer;
            padding: 2px;
        }
        .filter-tag .close:hover {
            opacity: 0.8;
        }
        .clickable {
            cursor: pointer;
            color: #602234;
        }
        .clickable:hover {
            text-decoration: underline;
        }
        .filter-value {
            cursor: pointer;
            color: #602234;
        }
        .filter-value:hover {
            text-decoration: underline;
        }
        @keyframes spin-slow {
            from {
                transform: rotate(0deg);
            }
            to {
                transform: rotate(360deg);
            }
        }
        .animate-spin-slow {
            animation: spin-slow 10s linear infinite;
        }
        /* Dark mode styles */
        .dark .table-header {
            background: #1a202c;
        }
        .dark .table-row:hover {
            background-color: rgba(255, 255, 255, 0.05);
        }
        .dark .neumorphic {
            background: #2d3748;
            box-shadow: 4px 4px 10px #1a202c,
                       -4px -4px 10px #4a5568;
        }
        .dark .neumorphic-btn {
            background: #2d3748;
            box-shadow: 4px 4px 8px #1a202c,
                       -4px -4px 8px #4a5568;
        }
        .dark {
            background-color: #1a202c;
            color: #f7fafc;
        }
        .dark .text-gray-600 {
            color: #cbd5e0;
        }
        .dark .bg-white {
            background-color: #2d3748;
        }
        /* Responsive table columns */
        @media (max-width: 1024px) {
            .col-major,
            .col-year {
                display: none;
            }
        }
        
        @media (max-width: 768px) {
            .col-location {
                display: none;
            }
        }
        
        @media (max-width: 640px) {
            .col-company {
                display: none;
            }
        }
        
        /* Search input styling */
        .search-input {
            background-color: white;
            border: 1px solid #e2e8f0;
            transition: all 0.3s ease;
        }
        
        .search-input:focus {
            border-color: #800000;
            box-shadow: 0 0 0 3px rgba(128, 0, 0, 0.1);
        }
        /* Table header icon colors and sizing */
        .table-header-icon {
            width: 1em;
            height: 1em;
            display: inline-block;
            vertical-align: middle;
            margin-right: 0.5em;
        }
        /* Hide up/down arrows in table headers */
        .sort-icon { display: none !important; }
        /* Filter modal redesign */
        .modal-content.nice-modal {
            background: #fff;
            border-radius: 1.25rem;
            box-shadow: 0 8px 32px rgba(60, 0, 0, 0.15);
            padding: 2rem 2.5rem;
            max-width: 480px;
            width: 95%;
            margin: 5% auto;
            max-height: 80vh;
            overflow-y: auto;
        }
        .filter-checkbox {
            accent-color: #602234;
            width: 1.1em;
            height: 1.1em;
            border-radius: 0.3em;
            margin-right: 0.5em;
            vertical-align: middle;
        }
        .filter-label {
            display: flex;
            align-items: center;
            margin-bottom: 0.5em;
            font-size: 1em;
            cursor: pointer;
        }
        .filter-group-title {
            font-weight: bold;
            margin-top: 1em;
            margin-bottom: 0.5em;
            color: #602234;
        }
        .search-filter-input {
            width: 100%;
            padding: 0.5rem;
            border: 1px solid #e2e8f0;
            border-radius: 0.375rem;
            margin-bottom: 1rem;
        }
        .search-filter-input:focus {
            outline: none;
            border-color: #602234;
            box-shadow: 0 0 0 3px rgba(96, 34, 52, 0.1);
        }
        .dynamic-checkboxes {
            margin-bottom: 1rem;
        }
        .close-button {
            background: #602234;
            color: white;
            padding: 0.5rem 1.5rem;
            border-radius: 0.375rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }
        .close-button:hover {
            background-color: #4a1a28;
        }
        .neumorphic-inner {
            background: #f0f0f0;
            box-shadow: inset 1.5px 1.5px 4px #e0e0e0, inset 2.5px 2.5px 8px #f7f7f7;
        }
        .close-button {
            background: #f0f0f0;
            color: #800000;
            border: none;
            box-shadow: inset 2px 2px 6px #d1d1d1, inset -2px -2px 6px #ffffff;
            padding: 0.5rem 1.5rem;
            border-radius: 0.375rem;
            font-weight: 500;
            transition: all 0.2s ease;
        }
        .close-button:hover {
            background: #e5e5e5;
        }
        .modal-content.nice-modal, .modal-content.neumorphic {
            box-shadow: inset 6px 6px 18px #d1d1d1, inset -6px -6px 18px #ffffff;
        }
        .directory-title {
            background-size: 200% 200%;
            animation: gradient-flow 3s ease-in-out infinite;
        }
        @keyframes gradient-flow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        /* Autocomplete dropdown for filter modal */
        .autocomplete-dropdown {
            position: absolute;
            z-index: 1001;
            background: #e5e7eb;
            border-radius: 0.5rem;
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
            width: 100%;
            max-height: 220px;
            overflow-y: auto;
            margin-top: 0.25rem;
        }
        .autocomplete-option {
            padding: 0.5rem 1rem;
            cursor: pointer;
            transition: background 0.15s;
        }
        .autocomplete-option:hover {
            background: #f3f4f6;
        }
        @keyframes gradient-flow-btn {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .animate-gradient-flow-btn {
            background-size: 200% 200%;
            animation: gradient-flow-btn 6s ease-in-out infinite;
        }
        .filter-checkbox, .column-toggle {
            transition: box-shadow 0.2s, transform 0.2s;
        }
        .filter-checkbox:checked, .column-toggle:checked {
            box-shadow: 0 0 0 4px #60223422;
            transform: scale(1.12);
        }
        /* Filter modal checkboxes alignment and style */
        #filter-modal .dynamic-checkboxes .filter-label {
            margin-left: 0 !important;
            padding-left: 0.25rem !important;
        }
        #filter-modal .filter-checkbox {
            box-shadow: none !important;
            outline: none !important;
            border: 2px solid #bbb !important;
        }
        #filter-modal .filter-checkbox:checked {
            box-shadow: none !important;
            outline: none !important;
            border: 2px solid #602234 !important;
        }
        #filter-modal .dynamic-checkboxes {
            margin-left: 0 !important;
        }
        /* Hide scrollbar for modals */
        .modal-content.nice-modal, .modal-content.neumorphic {
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        .modal-content.nice-modal::-webkit-scrollbar, .modal-content.neumorphic::-webkit-scrollbar {
            display: none;
        }
        .column-toggle {
            width: 1.5rem;
            height: 1.5rem;
            border-radius: 0.375rem;
            border: 2px solid #602234;
            appearance: none;
            -webkit-appearance: none;
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease;
        }
        .column-toggle:checked {
            background-color: #602234;
        }
        .column-toggle:checked::after {
            content: '✓';
            position: absolute;
            color: white;
            font-size: 1rem;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
        .column-toggle:nth-child(odd) {
            border-color: #000;
        }
        .column-toggle:nth-child(odd):checked {
            background-color: #000;
        }
        .column-label {
            font-size: 1.1rem;
            font-weight: 500;
            color: #333;
            margin-left: 0.75rem;
        }
        .filter-card {
            display: inline-flex;
            align-items: center;
            padding: 0.5rem 1rem;
            border-radius: 9999px;
            margin: 0.5rem;
            font-size: 0.9rem;
            font-weight: 500;
            color: white;
        }
        .filter-card:nth-child(odd) {
            background-color: #602234;
        }
        .filter-card:nth-child(even) {
            background-color: #000;
        }
        .filter-card .close {
            margin-left: 0.75rem;
            cursor: pointer;
            font-size: 1.1rem;
            opacity: 0.8;
            transition: opacity 0.2s;
        }
        .filter-card .close:hover {
            opacity: 1;
        }
        .custom-dropdown-options {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: white;
            border: 1px solid #e5e7eb;
            border-radius: 0.5rem;
            margin-top: 0.25rem;
            max-height: 200px;
            overflow-y: auto;
            z-index: 50;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        }
        .custom-dropdown-option {
            padding: 0.5rem 1rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .custom-dropdown-option:hover {
            background-color: #602234;
            color: white;
        }
        .modal-close-btn {
            position: absolute;
            bottom: 1.5rem;
            right: 1.5rem;
            padding: 0.75rem 1.5rem;
            background-color: #602234;
            color: white;
            border-radius: 0.5rem;
            font-weight: 500;
            transition: all 0.2s;
        }
        .modal-close-btn:hover {
            background-color: #4a1a28;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col dot-pattern">
    <div id="navbar-container"></div>

    <main class="w-full md:w-[90vw] md:container mx-auto py-4 md:py-8 mt-20 px-1 md:px-0 overflow-x-auto">
        <div class="w-full">
            <!-- Search and Filter Section -->
            <div class="modern-card p-2 md:p-6 rounded-none md:rounded-[1.25rem]">
                <div class="flex flex-col md:flex-row gap-4 items-center justify-between mb-2">
                    <div class="relative w-full md:w-1/2">
                        <i class="fas fa-search absolute left-3 input-icon text-gray-400"></i>
                        <input type="text" id="searchInput" class="modern-input w-full pl-10 pr-4 py-3" placeholder="Search alumni...">
                    </div>
                    <div class="hidden md:flex gap-4 w-auto justify-end">
                        <button id="filterBtn" class="bg-[#602234] hover:bg-[#4a1a28] text-white font-semibold py-2 px-4 rounded-lg transition-colors flex items-center">
                            <i class="fas fa-filter mr-2"></i>
                            Filter
                        </button>
                    </div>
                </div>
                <!-- Active Filters -->
                <div id="activeFilters" class="flex flex-wrap mt-4"></div>
                <div class="table-container mt-6">
                    <table>
                        <thead>
                            <tr class="border-b-2 border-gray-200">
                                <th class="name-col text-left py-4 px-6">Name</th>
                                <th class="text-left py-4 px-6">School</th>
                                <th class="text-left py-4 px-6">Graduation Year</th>
                                <th class="text-left py-4 px-6">Major</th>
                                <th class="text-left py-4 px-6">Position</th>
                                <th class="text-left py-4 px-6">Company</th>
                                <th class="text-left py-4 px-6">Location</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% alumni.forEach(alum => { %>
                                <% const school = Array.isArray(alum.school) ? alum.school : []; %>
                                <% const major = Array.isArray(alum.major) ? alum.major : []; %>
                                <% const currentPosition = Array.isArray(alum.currentPosition) ? alum.currentPosition : []; %>
                                <% const company = Array.isArray(alum.company) ? alum.company : []; %>
                                <% const location = Array.isArray(alum.location) ? alum.location : []; %>
                                <tr class="border-b border-gray-200 hover:bg-gray-50">
                                    <td class="name-col py-4 px-6">
                                        <div>
                                            <a href="/user/<%= alum.username %>" class="font-semibold text-gray-800 hover:text-[#602234] transition-colors"><%= alum.name %></a>
                                            <div class="text-sm text-gray-500 hidden md:block">@<%= alum.username %></div>
                                        </div>
                                    </td>
                                    <td class="py-4 px-6 text-gray-600" data-filter="school" data-values="<%= JSON.stringify(school) %>">
                                        <% if (!school.length) { %>
                                            n/a
                                        <% } else { %>
                                            <% school.forEach((item, index) => { %>
                                                <% if (index > 0) { %>, <% } %><span class="filter-value" data-filter="school" data-value="<%= item %>"><%= item %></span>
                                            <% }); %>
                                        <% } %>
                                    </td>
                                    <td class="py-4 px-6 text-gray-600 clickable" data-filter="graduationYear"><%= alum.graduationYear == 1900 ? '1900 (default)' : (alum.graduationYear || 'n/a') %></td>
                                    <td class="py-4 px-6 text-gray-600" data-filter="major" data-values="<%= JSON.stringify(major) %>">
                                        <% if (!major.length) { %>
                                            n/a
                                        <% } else { %>
                                            <% major.forEach((item, index) => { %>
                                                <% if (index > 0) { %>, <% } %><span class="filter-value" data-filter="major" data-value="<%= item %>"><%= item %></span>
                                            <% }); %>
                                        <% } %>
                                    </td>
                                    <td class="py-4 px-6 text-gray-600" data-filter="currentPosition" data-values="<%= JSON.stringify(currentPosition) %>">
                                        <% if (!currentPosition.length) { %>
                                            n/a
                                        <% } else { %>
                                            <% currentPosition.forEach((item, index) => { %>
                                                <% if (index > 0) { %>, <% } %><span class="filter-value" data-filter="currentPosition" data-value="<%= item %>"><%= item %></span>
                                            <% }); %>
                                        <% } %>
                                    </td>
                                    <td class="py-4 px-6 text-gray-600" data-filter="company" data-values="<%= JSON.stringify(company) %>">
                                        <% if (!company.length) { %>
                                            n/a
                                        <% } else { %>
                                            <% company.forEach((item, index) => { %>
                                                <% if (index > 0) { %>, <% } %><span class="filter-value" data-filter="company" data-value="<%= item %>"><%= item %></span>
                                            <% }); %>
                                        <% } %>
                                    </td>
                                    <td class="py-4 px-6 text-gray-600" data-filter="location" data-values="<%= JSON.stringify(location) %>">
                                        <% if (!location.length) { %>
                                            n/a
                                        <% } else { %>
                                            <% location.forEach((item, index) => { %>
                                                <% if (index > 0) { %>, <% } %><span class="filter-value" data-filter="location" data-value="<%= item %>"><%= item %></span>
                                            <% }); %>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <!-- Filter Modal -->
    <div id="filterModal" class="fixed inset-0 bg-black bg-opacity-50 hidden items-center justify-center z-50">
        <div class="bg-white rounded-xl p-8 w-11/12 sm:w-3/4 md:w-2/3 lg:w-1/2 max-h-[90vh] overflow-y-auto relative">
            <div class="flex justify-between items-center mb-6">
                <h2 class="text-2xl font-bold text-[#602234]">Filter Alumni</h2>
                <button id="closeFilterModalBtn" class="text-gray-500 hover:text-gray-700">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
            <div class="space-y-6">
                <!-- School Filter -->
                <div class="filter-group relative">
                    <label class="block text-sm font-medium text-gray-700 mb-2">School</label>
                    <div class="custom-dropdown">
                        <input type="text" class="filter-search w-full px-3 py-2 border border-gray-300 rounded-lg" placeholder="Search schools...">
                        <div class="custom-dropdown-options hidden"></div>
                    </div>
                </div>

                <!-- Graduation Year Filter -->
                <div class="filter-group relative">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Graduation Year</label>
                    <div class="custom-dropdown">
                        <input type="text" class="filter-search w-full px-3 py-2 border border-gray-300 rounded-lg" placeholder="Search years...">
                        <div class="custom-dropdown-options hidden"></div>
                    </div>
                </div>

                <!-- Major Filter -->
                <div class="filter-group relative">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Major</label>
                    <div class="custom-dropdown">
                        <input type="text" class="filter-search w-full px-3 py-2 border border-gray-300 rounded-lg" placeholder="Search majors...">
                        <div class="custom-dropdown-options hidden"></div>
                    </div>
                </div>

                <!-- Position Filter -->
                <div class="filter-group relative">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Position</label>
                    <div class="custom-dropdown">
                        <input type="text" class="filter-search w-full px-3 py-2 border border-gray-300 rounded-lg" placeholder="Search positions...">
                        <div class="custom-dropdown-options hidden"></div>
                    </div>
                </div>

                <!-- Company Filter -->
                <div class="filter-group relative">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Company</label>
                    <div class="custom-dropdown">
                        <input type="text" class="filter-search w-full px-3 py-2 border border-gray-300 rounded-lg" placeholder="Search companies...">
                        <div class="custom-dropdown-options hidden"></div>
                    </div>
                </div>

                <!-- Location Filter -->
                <div class="filter-group relative">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Location</label>
                    <div class="custom-dropdown">
                        <input type="text" class="filter-search w-full px-3 py-2 border border-gray-300 rounded-lg" placeholder="Search locations...">
                        <div class="custom-dropdown-options hidden"></div>
                    </div>
                </div>
            </div>
            <div class="mt-8 flex justify-end">
                <button id="closeFilterModalBtn" class="bg-[#602234] text-white px-6 py-3 rounded-lg hover:bg-[#4a1a28] transition-colors">
                    Close
                </button>
            </div>
        </div>
    </div>

    </div>

    <script type="module">
        import Navbar from '../../components/navbar.js';
        
        // Initialize navbar
        const navbar = new Navbar();
        document.getElementById('navbar-container').innerHTML = navbar.render();
        navbar.init();

        $(document).ready(function() {
            // Filter and Column button functionality
            $('#filterBtn').on('click', function() {
                $('#filterModal').removeClass('hidden').addClass('flex');
            });

            $('#closeFilterModal, #closeFilterModalBtn').on('click', function() {
                $('#filterModal').addClass('hidden').removeClass('flex');
            });

            $('.fixed').on('click', function(e) {
                if (e.target === this) {
                    $(this).addClass('hidden').removeClass('flex');
                }
            });

            function getCellValues($cell) {
                const stored = $cell.data('values');
                if (Array.isArray(stored)) return stored.map(value => String(value).trim()).filter(Boolean);
                const attr = $cell.attr('data-values');
                if (attr) {
                    try {
                        const parsed = JSON.parse(attr);
                        if (Array.isArray(parsed)) return parsed.map(value => String(value).trim()).filter(Boolean);
                    } catch (error) {}
                }
                const text = $cell.text().trim();
                if (!text || text === 'n/a') return [];
                return text.split(',').map(part => part.trim()).filter(part => part && part !== 'etc.');
            }

            function addFilter(column, value) {
                if (!value || value === 'n/a') return;
                const filterId = `${column}-${value}`;
                if ($(`#filter-${filterId}`).length) return;
                const displayName = String(column).split(/(?=[A-Z])/).map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ');
                $('#activeFilters').append(`
                    <div id="filter-${filterId}" class="filter-card">
                        ${displayName}: ${value}
                        <span class="close" data-column="${column}" data-value="${value}">×</span>
                    </div>
                `);
                applyFilters();
            }

            // Initialize filter options
            function initializeFilterOptions() {
                const columns = ['school', 'graduationYear', 'major', 'currentPosition', 'company', 'location'];
                columns.forEach(column => {
                    const uniqueValues = new Set();
                    $(`td[data-filter="${column}"]`).each(function() {
                        if (column === 'graduationYear') {
                            const value = $(this).text().trim();
                            if (value && value !== 'n/a') uniqueValues.add(value);
                        } else {
                            getCellValues($(this)).forEach(value => uniqueValues.add(value));
                        }
                    });
                    
                    const options = Array.from(uniqueValues).sort((a, b) => {
                        if (column === 'graduationYear') {
                            return parseInt(a) - parseInt(b);
                        }
                        return a.localeCompare(b);
                    });
                    
                    const labelMap = {
                        school: 'School',
                        graduationYear: 'Graduation Year',
                        major: 'Major',
                        currentPosition: 'Position',
                        company: 'Company',
                        location: 'Location'
                    };
                    const filterGroup = $(`.filter-group:has(label:contains('${labelMap[column]}'))`);
                    const optionsContainer = filterGroup.find('.custom-dropdown-options');
                    
                    optionsContainer.empty();
                    options.forEach(option => {
                        optionsContainer.append(`
                            <div class="custom-dropdown-option" data-value="${option}">
                                ${option}
                            </div>
                        `);
                    });
                });
            }

            // Initialize filter options on page load
            initializeFilterOptions();

            // Filter search functionality
            $('.filter-search').on('input', function() {
                const searchTerm = $(this).val().toLowerCase();
                const options = $(this).siblings('.custom-dropdown-options');
                const optionsList = options.find('.custom-dropdown-option');
                
                optionsList.each(function() {
                    const text = $(this).text().toLowerCase();
                    $(this).toggle(text.includes(searchTerm));
                });
                
                options.toggleClass('hidden', !searchTerm);
            });

            // Close dropdowns when clicking outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('.custom-dropdown').length) {
                    $('.custom-dropdown-options').addClass('hidden');
                }
            });

            // Apply filter when clicking on option
            $(document).on('click', '.custom-dropdown-option', function() {
                const value = $(this).data('value');
                const label = $(this).closest('.filter-group').find('label').text().trim().toLowerCase();
                const columnMap = {
                    'school': 'school',
                    'graduation year': 'graduationYear',
                    'major': 'major',
                    'position': 'currentPosition',
                    'company': 'company',
                    'location': 'location'
                };
                addFilter(columnMap[label] || label, value);
                $(this).closest('.custom-dropdown-options').addClass('hidden');
                $(this).closest('.filter-group').find('input').val('');
            });

            // Remove filter when clicking close button
            $('#activeFilters').on('click', '.close', function() {
                $(this).parent().remove();
                applyFilters();
            });

            // Apply all active filters
            function applyFilters() {
                const filters = {};
                $('.filter-card').each(function() {
                    const column = $(this).find('.close').data('column');
                    const value = $(this).find('.close').data('value');
                    if (!filters[column]) {
                        filters[column] = new Set();
                    }
                    filters[column].add(String(value));
                });

                $('tbody tr').each(function() {
                    let show = true;
                    const name = $(this).find('td:first').text().toLowerCase();
                    const search = ($('#searchInput').val() || '').toLowerCase();
                    if (search && !name.includes(search)) {
                        show = false;
                    }
                    for (const [column, values] of Object.entries(filters)) {
                        const $cell = $(this).find(`td[data-filter="${column}"]`);
                        if (column === 'graduationYear') {
                            if (!values.has($cell.text().trim())) {
                                show = false;
                                break;
                            }
                        } else {
                            const cellParts = getCellValues($cell);
                            if (![...values].some(value => cellParts.includes(value))) {
                                show = false;
                                break;
                            }
                        }
                    }
                    $(this).toggle(show);
                });
            }

            $('#searchInput').on('input', function() {
                applyFilters();
            });

            $(document).on('click', '.filter-value', function(e) {
                e.stopPropagation();
                addFilter($(this).data('filter'), $(this).data('value'));
            });

            $('td.clickable[data-filter]').on('click', function() {
                addFilter($(this).data('filter'), $(this).text().trim());
            });

            // Sort users with missing school or graduation year to bottom
            function sortUsers() {
                const rows = $('tbody tr').toArray();
                rows.sort((a, b) => {
                    const aSchool = $(a).find('td[data-filter="school"]').text().trim();
                    const bSchool = $(b).find('td[data-filter="school"]').text().trim();
                    const aYear = $(a).find('td[data-filter="graduationYear"]').text().trim();
                    const bYear = $(b).find('td[data-filter="graduationYear"]').text().trim();
                    
                    if (aSchool === 'n/a' && bSchool !== 'n/a') return 1;
                    if (aSchool !== 'n/a' && bSchool === 'n/a') return -1;
                    if (aYear === 'n/a' && bYear !== 'n/a') return 1;
                    if (aYear !== 'n/a' && bYear === 'n/a') return -1;
                    return 0;
                });
                
                $('tbody').append(rows);
            }

            // Sort users on page load
            sortUsers();
        });
    </script>
</body>
</html> 