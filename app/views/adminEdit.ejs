<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Slink | Edit Account</title>
    <link rel="icon" href="/images/slink-logo.png" type="image/x-icon">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        html, body { overflow: scroll; scrollbar-width: none; -ms-overflow-style: none; }
        html::-webkit-scrollbar, body::-webkit-scrollbar { display: none; }
        .dot-pattern {
            background-attachment: fixed;
            background-image: radial-gradient(rgba(96, 34, 52, 0.5) 1px, transparent 1px);
            background-size: 20px 20px;
            background-color: #ffffff;
        }
        .gradient-text {
            background: linear-gradient(45deg, #602234, #602234);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .autocomplete-dropdown {
            display: none;
            position: absolute;
            left: 0;
            right: 0;
            top: 100%;
            z-index: 30;
            background: white;
            border: 1px solid #000;
            margin-top: 0.25rem;
            max-height: 220px;
            overflow-y: auto;
        }
        .autocomplete-option { padding: 0.6rem 0.85rem; cursor: pointer; }
        .autocomplete-option:hover, .autocomplete-option.active { background: #602234; color: white; }
        .value-chip {
            background: #602234;
            color: white;
            padding: 0.35rem 0.75rem;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.9rem;
            border-radius: 0.5rem;
        }
        .empty-chips { color: #9ca3af; font-style: italic; font-size: 0.95rem; }
        .value-chip button { background: none; border: none; color: white; cursor: pointer; }
        .custom-select-options {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: white;
            border: 1px solid #000;
            border-radius: 0.5rem;
            margin-top: 0.5rem;
            z-index: 40;
        }
        .custom-select-option { padding: 0.75rem 1rem; cursor: pointer; color: #718096; }
        .custom-select-option:hover { background: #602234; color: white; }
    </style>
</head>
<body class="min-h-screen flex flex-col dot-pattern">
    <div id="navbar-container"></div>
    <main class="container w-[90vw] mx-auto py-4 md:py-8 mt-20">
        <form id="profile-form" action="/admin/edit/<%= userId %>" method="POST" class="bg-white rounded-xl p-4 md:p-8 shadow-lg border-2 border-[#602234]">
            <div class="flex justify-between items-center mb-6 md:mb-8">
                <h1 class="text-3xl md:text-5xl font-extrabold gradient-text">Edit Account</h1>
                <a href="/admin" class="bg-gray-100 hover:bg-gray-200 text-gray-800 font-semibold py-2 px-4 rounded-lg">Back to Admin</a>
            </div>

            <div class="flex flex-col gap-6">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-10 gap-y-6">
                    <div>
                        <label class="block text-xl font-medium text-black mb-2">Full Name</label>
                        <input type="text" name="name" maxlength="50" class="w-full px-4 py-3 rounded-lg border border-black" required>
                    </div>
                    <div>
                        <label class="block text-xl font-medium text-black mb-2">Username</label>
                        <input type="text" name="username" maxlength="15" class="w-full px-4 py-3 rounded-lg border border-black" required>
                    </div>
                    <div>
                        <label class="block text-xl font-medium text-black mb-2">Email</label>
                        <input type="email" name="email" class="w-full px-4 py-3 rounded-lg border border-black" required>
                    </div>
                    <div class="relative custom-select">
                        <label class="block text-xl font-medium text-black mb-2">Role</label>
                        <div class="flex flex-row cursor-pointer" id="roleSelect">
                            <div class="w-full px-4 py-3 border border-black rounded-lg bg-white" id="roleSelectText">Select role</div>
                        </div>
                        <div class="custom-select-options">
                            <div class="custom-select-option" data-value="alumni">Alumni</div>
                            <div class="custom-select-option" data-value="student">Student</div>
                            <div class="custom-select-option" data-value="staff">Staff</div>
                            <div class="custom-select-option" data-value="parent">Parent</div>
                        </div>
                        <input type="hidden" name="position">
                    </div>
                </div>

                <div>
                    <label class="block text-xl font-medium text-black mb-2">Bio</label>
                    <textarea name="bio" maxlength="1000" class="w-full px-4 py-3 rounded-lg border border-black h-32"></textarea>
                </div>

                <label class="inline-flex items-center text-lg font-medium text-black">
                    <input type="checkbox" name="admin" id="adminFlag" class="mr-3 w-5 h-5">
                    Admin privileges
                </label>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-x-10 gap-y-6">
                    <div class="multi-field flex flex-col" data-field="school" data-suggest="schools" data-empty="No colleges added yet...">
                        <label class="block text-xl font-medium text-black mb-2">College(s)</label>
                        <div class="chips flex flex-wrap gap-2 mb-2"></div>
                        <div class="relative">
                            <input type="text" maxlength="100" autocomplete="off" class="multi-input w-full px-4 py-3 rounded-lg border border-black" placeholder="Type a school and press Enter">
                            <div class="autocomplete-dropdown"></div>
                        </div>
                    </div>
                    <div class="multi-field flex flex-col" data-field="major" data-suggest="majors" data-empty="No majors added yet...">
                        <label class="block text-xl font-medium text-black mb-2">Major(s)</label>
                        <div class="chips flex flex-wrap gap-2 mb-2"></div>
                        <div class="relative">
                            <input type="text" maxlength="100" autocomplete="off" class="multi-input w-full px-4 py-3 rounded-lg border border-black" placeholder="Type a major and press Enter">
                            <div class="autocomplete-dropdown"></div>
                        </div>
                    </div>
                    <div class="multi-field flex flex-col" data-field="currentPosition" data-suggest="positions" data-empty="No positions added yet...">
                        <label class="block text-xl font-medium text-black mb-2">Position(s)</label>
                        <div class="chips flex flex-wrap gap-2 mb-2"></div>
                        <div class="relative">
                            <input type="text" maxlength="100" autocomplete="off" class="multi-input w-full px-4 py-3 rounded-lg border border-black" placeholder="Type a position and press Enter">
                            <div class="autocomplete-dropdown"></div>
                        </div>
                    </div>
                    <div class="multi-field flex flex-col" data-field="company" data-empty="No companies added yet...">
                        <label class="block text-xl font-medium text-black mb-2">Company(s)</label>
                        <div class="chips flex flex-wrap gap-2 mb-2"></div>
                        <input type="text" maxlength="100" autocomplete="off" class="multi-input w-full px-4 py-3 rounded-lg border border-black" placeholder="Type a company and press Enter">
                    </div>
                    <div>
                        <label class="block text-xl font-medium text-black mb-2">High School Graduation Year</label>
                        <div class="chips flex flex-wrap gap-2 mb-2">
                            <span class="empty-chips">Enter high school graduation year below...</span>
                        </div>
                        <input type="number" name="graduationYear" min="1900" max="2100" class="w-full px-4 py-3 rounded-lg border border-black">
                    </div>
                    <div class="multi-field flex flex-col" data-field="location" data-suggest="cities" data-empty="No locations added yet...">
                        <label class="block text-xl font-medium text-black mb-2">Location(s)</label>
                        <div class="chips flex flex-wrap gap-2 mb-2"></div>
                        <div class="relative">
                            <input type="text" maxlength="100" autocomplete="off" class="multi-input w-full px-4 py-3 rounded-lg border border-black" placeholder="Type a city and press Enter">
                            <div class="autocomplete-dropdown"></div>
                        </div>
                    </div>
                    <div class="multi-field flex flex-col" data-field="interests" data-suggest="interests" data-empty="No interests added yet...">
                        <label class="block text-xl font-medium text-black mb-2">Interest(s)</label>
                        <div class="chips flex flex-wrap gap-2 mb-2"></div>
                        <div class="relative">
                            <input type="text" maxlength="100" autocomplete="off" class="multi-input w-full px-4 py-3 rounded-lg border border-black" placeholder="Type an interest and press Enter">
                            <div class="autocomplete-dropdown"></div>
                        </div>
                    </div>
                    <div class="multi-field flex flex-col" data-field="extracurriculars" data-suggest="extracurriculars" data-empty="No extracurriculars added yet...">
                        <label class="block text-xl font-medium text-black mb-2">Extracurricular(s)</label>
                        <div class="chips flex flex-wrap gap-2 mb-2"></div>
                        <div class="relative">
                            <input type="text" maxlength="120" autocomplete="off" class="multi-input w-full px-4 py-3 rounded-lg border border-black" placeholder="Type an extracurricular and press Enter">
                            <div class="autocomplete-dropdown"></div>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xl font-medium text-black mb-2">LinkedIn</label>
                        <input type="text" name="linkedin" class="w-full px-4 py-3 rounded-lg border border-black" placeholder="https://linkedin.com/in/...">
                    </div>
                    <div>
                        <label class="block text-xl font-medium text-black mb-2">Instagram</label>
                        <input type="text" name="instagram" class="w-full px-4 py-3 rounded-lg border border-black" placeholder="https://instagram.com/...">
                    </div>
                    <div>
                        <label class="block text-xl font-medium text-black mb-2">Discord</label>
                        <input type="text" name="discord" class="w-full px-4 py-3 rounded-lg border border-black" placeholder="Discord username">
                    </div>
                    <div>
                        <label class="block text-xl font-medium text-black mb-2">Personal Website</label>
                        <input type="text" name="website" class="w-full px-4 py-3 rounded-lg border border-black" placeholder="https://...">
                    </div>
                </div>
            </div>

            <button type="submit" class="w-full mt-10 bg-[#602234] hover:bg-[#4a1a28] text-white text-lg font-bold rounded-lg px-8 py-4">
                Save Changes
            </button>
        </form>
    </main>

    <script type="application/json" id="user-json"><%- user %></script>
    <script>
        window.userData = JSON.parse(document.getElementById('user-json').textContent);
    </script>
    <script type="module">
        import Navbar from '../../components/navbar.js';
        const navbar = new Navbar();
        document.getElementById('navbar-container').innerHTML = navbar.render();
        navbar.init();
    </script>
    <script>
        const multiFields = ['school', 'major', 'currentPosition', 'company', 'location', 'interests', 'extracurriculars'];
        const suggestionCache = {};

        function toList(value) {
            if (Array.isArray(value)) {
                return value.filter(v => v && String(v).trim() && String(v).toLowerCase() !== 'n/a');
            }
            if (!value || String(value).toLowerCase() === 'n/a') return [];
            return [String(value)];
        }

        function renderChips($field) {
            const values = $field.data('values') || [];
            const $chips = $field.find('.chips');
            const emptyText = $field.data('empty') || 'No items added yet...';
            $chips.empty();
            if (!values.length) {
                $chips.append(`<span class="empty-chips"></span>`);
                $chips.find('.empty-chips').text(emptyText);
                return;
            }
            values.forEach((value, index) => {
                const $chip = $(`<span class="value-chip"><span></span><button type="button">&times;</button></span>`);
                $chip.find('span').first().text(value);
                $chip.find('button').on('click', function() {
                    $field.data('values', ($field.data('values') || []).filter((_, i) => i !== index));
                    renderChips($field);
                });
                $chips.append($chip);
            });
        }

        function addValue($field, rawValue) {
            const value = (rawValue || '').trim();
            if (!value) return;
            const values = $field.data('values') || [];
            if (values.some(v => v.toLowerCase() === value.toLowerCase())) return;
            values.push(value);
            $field.data('values', values);
            renderChips($field);
            $field.find('.multi-input').val('');
            $field.find('.autocomplete-dropdown').hide().empty();
        }

        async function loadSuggestions(name) {
            if (!name) return [];
            if (suggestionCache[name]) return suggestionCache[name];
            const response = await fetch(`/data/${name}.txt`);
            suggestionCache[name] = (await response.text()).split(/\r?\n/).map(line => line.trim()).filter(Boolean);
            return suggestionCache[name];
        }

        function showSuggestions($field, matches) {
            const $dropdown = $field.find('.autocomplete-dropdown');
            if (!matches.length) return $dropdown.hide().empty();
            $dropdown.empty();
            matches.slice(0, 8).forEach((match, index) => {
                const $option = $('<div class="autocomplete-option"></div>').text(match);
                if (index === 0) $option.addClass('active');
                $option.on('mousedown', function(e) {
                    e.preventDefault();
                    addValue($field, match);
                });
                $dropdown.append($option);
            });
            $dropdown.show();
        }

        function populateForm() {
            const form = $('#profile-form');
            const userData = window.userData || {};
            for (const [key, value] of Object.entries(userData)) {
                if (key === 'socialLinks') {
                    for (const [socialKey, socialValue] of Object.entries(value || {})) {
                        const input = form.find(`[name="${socialKey}"]`);
                        if (input.length) {
                            let next = socialValue === 'n/a' ? '' : socialValue;
                            if (socialKey === 'discord') next = String(next || '').replace(/^https?:\/\//i, '').replace(/^www\./i, '');
                            input.val(next);
                        }
                    }
                } else if (key === 'position' && value) {
                    $('#roleSelectText').text(value.charAt(0).toUpperCase() + value.slice(1));
                    $('input[name="position"]').val(value);
                } else if (key === 'admin') {
                    $('#adminFlag').prop('checked', value === true);
                } else if (multiFields.includes(key)) {
                    const $field = form.find(`.multi-field[data-field="${key}"]`);
                    $field.data('values', toList(value));
                    renderChips($field);
                } else {
                    const input = form.find(`[name="${key}"]`);
                    if (input.length) {
                        input.val((!value || ['n/a', 'no bio yet...'].includes(String(value).toLowerCase())) ? '' : value);
                    }
                }
            }
        }

        $(document).ready(function() {
            populateForm();
            $('#roleSelect').on('click', function() { $('.custom-select-options').slideToggle(); });
            $('.custom-select-option').on('click', function(e) {
                e.stopPropagation();
                $('input[name="position"]').val($(this).data('value'));
                $('#roleSelectText').text($(this).text());
                $('.custom-select-options').slideUp();
            });
            $(document).on('click', function(e) {
                if (!$(e.target).closest('.custom-select').length) $('.custom-select-options').slideUp();
            });

            $('.multi-field').each(function() {
                const $field = $(this);
                if (!$field.data('values')) $field.data('values', []);
                renderChips($field);
                const suggestName = $field.data('suggest');
                if (suggestName) loadSuggestions(suggestName);
                $field.find('.multi-input').on('input', async function() {
                    const query = $(this).val().trim().toLowerCase();
                    if (!suggestName || query.length < 1) return $field.find('.autocomplete-dropdown').hide().empty();
                    const matches = (await loadSuggestions(suggestName)).filter(item => item.toLowerCase().includes(query));
                    showSuggestions($field, matches);
                });
                $field.find('.multi-input').on('keydown', function(e) {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        const $active = $field.find('.autocomplete-option.active');
                        addValue($field, $active.length ? $active.text() : $(this).val());
                    }
                });
            });

            $('#profile-form').on('submit', function() {
                $('.multi-field').each(function() {
                    const $field = $(this);
                    addValue($field, $field.find('.multi-input').val());
                    $field.find(`input.multi-json[name="${$field.data('field')}"]`).remove();
                    $('<input type="hidden" class="multi-json">')
                        .attr('name', $field.data('field'))
                        .val(JSON.stringify($field.data('values') || []))
                        .appendTo($field);
                });
            });
        });
    </script>
</body>
</html>
