<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Slink | Authenticate</title>
    <link rel="icon" href="/images/slink-logo.png" type="image/x-icon">
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @keyframes gradient-flow {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        .gradient-text {
            background: linear-gradient(45deg, #602234, #602234);
            background-size: 200% 200%;
            animation: gradient-flow 3s ease-in-out infinite;
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }
        .atom {
            position: absolute;
            color: #602234;
            opacity: 0.4;
            pointer-events: none;
        }
        .error-toast {
            position: fixed;
            top: 1rem;
            left: 50%;
            transform: translateX(-50%);
            padding: 1rem;
            border-radius: 0.5rem;
            background: #602234;
            color: white;
            display: none;
            z-index: 50;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            transition: all 0.3s ease;
            animation: slideDown 0.3s ease-out;
        }
        @keyframes slideDown {
            from { transform: translate(-50%, -100%); }
            to { transform: translate(-50%, 0); }
        }
        .error-toast:hover {
            transform: translateX(-50%) scale(1.02);
            background: #4a1a28;
        }
        .custom-select-options {
            display: none;
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: white;
            border: 1px solid #000;
            border-radius: 0.5rem;
            margin-top: 0.5rem;
            z-index: 10;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }
        .custom-select-option {
            padding: 0.75rem 1rem;
            cursor: pointer;
            transition: all 0.2s ease;
            color: #718096;
        }
        .custom-select-option:hover {
            background: #602234;
            color: white;
        }
        .custom-select-option.selected {
            color: #000000;
        }
        @keyframes spin-slow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        .animate-spin-slow {
            animation: spin-slow 8s linear infinite;
        }
        body, html, .authenticate-form {
            overflow: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
        }
        .signup-extras {
            display: grid;
            grid-template-rows: 0fr;
            transition: grid-template-rows 0.45s ease;
        }
        .signup-extras.open {
            grid-template-rows: 1fr;
        }
        .signup-extras-inner {
            overflow: hidden;
            min-height: 0;
        }
        .signup-extras.allow-overflow .signup-extras-inner {
            overflow: visible;
        }
        body::-webkit-scrollbar,
        html::-webkit-scrollbar,
        .authenticate-form::-webkit-scrollbar {
            display: none;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-6 sm:p-8 md:p-4">
    <!-- Floating Atoms Background -->
    <div id="atoms-container"></div>

    <div class="w-full max-w-2xl md:max-w-3xl lg:max-w-4xl relative z-10">
        <div class="border-black border-2">
            <div id="authCard" class="bg-white px-8 py-14 md:px-16 md:py-16 shadow-lg transition-all duration-500 ease-in-out">
            <!-- Form Toggle Switch -->
            <div class="flex justify-center mb-8">
                <div class="bg-gray-200 rounded-full p-1 grid grid-cols-2 relative w-72">
                    <div id="toggleSlider" class="absolute bg-[#602234] rounded-full transition-all duration-500 ease-in-out" style="width: calc(50% - 0.25rem); height: calc(100% - 0.5rem); top: 0.25rem; left: 0.25rem;"></div>
                    <button type="button" id="loginToggle" class="px-4 py-2 rounded-full text-white font-semibold transition-all duration-300 relative z-10 text-center">
                        Log In
                    </button>
                    <button type="button" id="signupToggle" class="px-4 py-2 rounded-full text-gray-600 font-semibold transition-all duration-300 relative z-10 text-center">
                        Sign Up
                    </button>
                </div>
            </div>

            <!-- Forms Container -->
            <div class="relative authenticate-form">
                <form id="authForm" action="/authenticate/login" method="POST" class="w-full">
                    <div class="space-y-6">
                    <div class="flex flex-row relative">
                        <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <input type="text" id="emailInput" name="email" required autocomplete="off"
                               class="w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300"
                               placeholder="Enter your email">
                    </div>
                    <div class="flex flex-row relative">
                        <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                            <i class="fas fa-lock"></i>
                        </div>
                        <input type="password" id="passwordInput" name="password" required autocomplete="off"
                               class="w-full px-4 py-3 border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300"
                               placeholder="Enter your password">
                        <div class="rounded-r-lg bg-gray-100 flex items-center justify-center px-4 border border-l-0 border-black cursor-pointer" id="toggleLoginPassword">
                            <i class="fas fa-eye"></i>
                        </div>
                    </div>
                    </div>

                    <div id="signupExtras" class="signup-extras">
                        <div class="signup-extras-inner space-y-6 pt-6">
                            <div class="flex flex-row relative">
                                <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                    <i class="fas fa-lock"></i>
                                </div>
                                <input type="password" id="confirmPasswordInput" name="confirmPassword" autocomplete="off"
                                       class="w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300"
                                       placeholder="Confirm your password">
                                <i id="passwordMatchIcon" class="fas absolute right-3 top-1/2 transform -translate-y-1/2 hidden"></i>
                            </div>
                            <div class="flex flex-row relative">
                                <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                    <i class="fas fa-at"></i>
                                </div>
                                <input type="text" id="usernameInput" name="username" autocomplete="off"
                                       class="w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300"
                                       placeholder="Choose a username">
                            </div>
                            <div class="flex flex-row relative">
                                <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                    <i class="fas fa-user"></i>
                                </div>
                                <input type="text" id="nameInput" name="name" autocomplete="off"
                                       class="w-full px-4 py-3 rounded-r-lg border border-black focus:border-[#602234] focus:ring-2 focus:ring-[#602234]/20 focus:bg-gray-50 transition-all duration-300"
                                       placeholder="Enter your full name">
                            </div>
                            <div class="relative custom-select">
                                <div class="flex flex-row">
                                    <div class="rounded-l-lg bg-gray-100 flex items-center justify-center px-4 border border-r-0 border-black">
                                        <i class="fas fa-user-tag"></i>
                                    </div>
                                    <div class="w-full px-4 py-3 rounded-r-lg border border-black cursor-pointer text-gray-500 bg-white" id="roleSelect">
                                        Select your role
                                    </div>
                                </div>
                                <div class="custom-select-options max-h-48 overflow-y-auto">
                                    <div class="custom-select-option" data-value="alumni">Alumni</div>
                                    <div class="custom-select-option" data-value="student">Student</div>
                                    <div class="custom-select-option" data-value="staff">Staff</div>
                                    <div class="custom-select-option" data-value="parent">Parent</div>
                                </div>
                                <input type="hidden" id="positionInput" name="position">
                            </div>
                        </div>
                    </div>

                    <button type="submit" id="authSubmit"
                            class="mt-6 w-full bg-[#602234] text-white py-4 rounded-lg text-lg font-bold transition-all duration-300 transform hover:scale-[1.02] shadow-[inset_-4px_-4px_8px_rgba(0,0,0,0.3)]">
                        Log In
                        <i class="fas fa-key ml-2"></i>
                    </button>
                </form>
            </div>
            </div>
        </div>
    </div>

    <!-- Error Toast -->
    <div id="errorToast" class="error-toast w-11/12 sm:w-3/4 md:w-2/3 lg:w-1/2">
        <div class="flex items-center justify-center">
            <i class="fas fa-exclamation-circle mr-2 text-xl"></i>
            <span id="errorMessage" class="text-lg font-semibold"></span>
        </div>
    </div>

    <script>
        $(document).ready(function() {
            let isSignup = false;

            function setSignupMode(enabled) {
                isSignup = enabled;
                $('#signupExtras').toggleClass('open', enabled);
                if (enabled) {
                    setTimeout(() => $('#signupExtras').addClass('allow-overflow'), 450);
                } else {
                    $('#signupExtras').removeClass('allow-overflow');
                }
                $('#authForm').attr('action', enabled ? '/authenticate/signup' : '/authenticate/login');
                $('#confirmPasswordInput, #usernameInput, #nameInput').prop('required', enabled);
                if (enabled) {
                    $('#toggleSlider').css('left', '50%');
                    $('#signupToggle').addClass('text-white').removeClass('text-gray-600');
                    $('#loginToggle').removeClass('text-white').addClass('text-gray-600');
                    $('#authSubmit').html('Sign Up <i class="fas fa-user-plus ml-2"></i>');
                } else {
                    $('#toggleSlider').css('left', '0.25rem');
                    $('#loginToggle').addClass('text-white').removeClass('text-gray-600');
                    $('#signupToggle').removeClass('text-white').addClass('text-gray-600');
                    $('#authSubmit').html('Log In <i class="fas fa-key ml-2"></i>');
                }
            }

            $('#loginToggle').click(function() {
                setSignupMode(false);
            });

            $('#signupToggle').click(function() {
                setSignupMode(true);
            });

            setSignupMode(false);

            // Custom Select
            $('#roleSelect').click(function() {
                $('.custom-select-options').slideToggle();
            });

            $('.custom-select-option').click(function() {
                const value = $(this).data('value');
                const text = $(this).text();
                $('#roleSelect').text(text).removeClass('text-gray-500').addClass('text-black');
                $('input[name="position"]').val(value);
                $('.custom-select-options').slideUp();
                $('.custom-select-option').removeClass('selected');
                $(this).addClass('selected');
            });

            // Password Match Validation
            $('#confirmPasswordInput').on('input', function() {
                const password = $('#passwordInput').val();
                const confirmPassword = $(this).val();
                const icon = $('#passwordMatchIcon');
                
                if (confirmPassword) {
                    if (password === confirmPassword) {
                        icon.removeClass('fa-times text-red-500').addClass('fa-check text-green-500 text-xl font-bold').removeClass('hidden');
                    } else {
                        icon.removeClass('fa-check text-green-500').addClass('fa-times text-red-500 text-xl font-bold').removeClass('hidden');
                    }
                } else {
                    icon.addClass('hidden');
                }
            });

            // Client-side Validation
            function showError(message) {
                $('#errorMessage').text(message);
                $('#errorToast').fadeIn().delay(3000).fadeOut();
            }

            $('#authForm').on('submit', function(e) {
                if (!isSignup) return;
                const name = $('#nameInput').val();
                const email = $('#emailInput').val();
                const username = $('#usernameInput').val();
                const password = $('#passwordInput').val();
                const confirmPassword = $('#confirmPasswordInput').val();
                const position = $('#positionInput').val();

                    // Name validation
                    if (!/\s/.test(name)) {
                        e.preventDefault();
                        showError("Name must contain a space");
                        return;
                    }

                    // Email validation
                    if (!/^\S+@\S+\.\S+$/.test(email)) {
                        e.preventDefault();
                        showError("Email address is not valid");
                        return;
                    }

                    // Password validation
                    if (!/^(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]).{8,}$/.test(password)) {
                        e.preventDefault();
                        showError("Password must be at least 8 characters long and include at least one uppercase letter, one number, and one special character");
                        return;
                    }

                    // Password match validation
                    if (password !== confirmPassword) {
                        e.preventDefault();
                        showError("Passwords do not match");
                        return;
                    }

                    // Position validation
                    if (!position) {
                        e.preventDefault();
                        showError("Please select a position");
                        return;
                    }
            });

            // Floating Atoms Animation
            function createAtom() {
                const atom = $('<i class="fas fa-atom atom"></i>');
                const container = $('#atoms-container');
                const containerWidth = $(window).width();
                const containerHeight = $(window).height();
                
                // Responsive size based on screen width
                const size = window.innerWidth < 640 ? 'text-5xl' : 
                           window.innerWidth < 1024 ? 'text-6xl' : 'text-7xl';
                atom.addClass(size);
                
                let x = Math.random() * containerWidth;
                let y = Math.random() * containerHeight;
                const speed = 2;
                let vx = (Math.random() - 0.5) * speed;
                let vy = (Math.random() - 0.5) * speed;
                let rotation = Math.random() * 360;
                let rotationSpeed = (Math.random() - 0.5) * 2; // Random rotation speed between -1 and 1
                
                atom.css({
                    left: x + 'px',
                    top: y + 'px',
                    transform: `rotate(${rotation}deg)`
                });
                
                container.append(atom);
                
                function animate() {
                    x += vx;
                    y += vy;
                    rotation += rotationSpeed;
                    
                    if (x <= 0 || x >= containerWidth) {
                        vx *= -1;
                        x = x <= 0 ? 0 : containerWidth;
                    }
                    if (y <= 0 || y >= containerHeight) {
                        vy *= -1;
                        y = y <= 0 ? 0 : containerHeight;
                    }
                    
                    atom.css({
                        left: x + 'px',
                        top: y + 'px',
                        transform: `rotate(${rotation}deg)`
                    });
                    
                    requestAnimationFrame(animate);
                }
                
                animate();
            }

            // Create all atoms simultaneously
            const numAtoms = 10;
            for (let i = 0; i < numAtoms; i++) {
                createAtom();
            }

            // Close error toast on click
            $('#errorToast').click(function() {
                $(this).fadeOut();
            });

            // Show/hide password for login form
            $('#toggleLoginPassword').on('click', function() {
                var $input = $('#passwordInput');
                var $icon = $(this).find('i');
                if ($input.attr('type') === 'password') {
                    $input.attr('type', 'text');
                    $icon.removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    $input.attr('type', 'password');
                    $icon.removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            // Custom Select: close dropdown if clicking outside
            $(document).on('click', function(e) {
                if (!$(e.target).closest('.custom-select').length) {
                    $('.custom-select-options').slideUp();
                }
            });
        });
    </script>
</body>
</html> 